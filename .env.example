DATABASE_URL=postgres://sales_saas:sales_saas@localhost:5434/sales_aaas
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Auth (NextAuth)
AUTH_SECRET=your-secret-key-min-32-chars-change-in-production
# For Google OAuth, also set in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (Global payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs from your dashboard (set in .env or keep in code)
# Example: STRIPE_PRICE_STARTER=price_xxx, STRIPE_PRICE_PRO=price_xxx, STRIPE_PRICE_ELITE=price_xxx

# Razorpay (India payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay plan IDs from your dashboard
# Example: RAZORPAY_PLAN_STARTER=plan_xxx, RAZORPAY_PLAN_PRO=plan_xxx, RAZORPAY_PLAN_ELITE=plan_xxx

# Communications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TWIML_URL=
TWILIO_STATUS_CALLBACK_URL=

# AI (future)
OPENAI_API_KEY=
