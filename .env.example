TELEGRAM_NOTIFICATION_PAYLOAD_REVIEW_CONFIGURED=false
TELEGRAM_NOTIFICATION_PAYLOAD_REVIEW_URL=
TELEGRAM_NOTIFICATION_MAX_PER_HOUR=12

# Source providers
# Use SOURCE_PROVIDER_API_KEY for a shared source-provider adapter, or provider-specific keys
# for narrower activation. These power governance-gated, cost-controlled evidence runs,
# not universal scraping.
SOURCE_PROVIDER_API_KEY=
WEBSITE_SOURCE_PROVIDER_API_KEY=
SEARCH_SOURCE_PROVIDER_API_KEY=
DIRECTORY_SOURCE_PROVIDER_API_KEY=

# Source-provider governance readiness
# These are runtime gates plus readiness flags/policy links, not provider credentials.
# Configured source-provider evidence runs are blocked until every gate is configured.
SOURCE_PROVIDER_TERMS_POLICY_CONFIGURED=false
SOURCE_PROVIDER_TERMS_POLICY_URL=
SOURCE_PROVIDER_RATE_LIMIT_POLICY_CONFIGURED=false
SOURCE_PROVIDER_RATE_LIMIT_POLICY_URL=
SOURCE_PROVIDER_CONSENT_POLICY_CONFIGURED=false
SOURCE_PROVIDER_CONSENT_POLICY_URL=
SOURCE_PROVIDER_INVOICE_RECONCILIATION_CONFIGURED=false
SOURCE_PROVIDER_INVOICE_RECONCILIATION_URL=
SOURCE_PROVIDER_QUALITY_GOVERNANCE_CONFIGURED=false
SOURCE_PROVIDER_QUALITY_GOVERNANCE_POLICY_URL=

# Conversion integration readiness
