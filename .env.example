# =============================================================================
# MINIMUM TO BOOT (local development)
# =============================================================================
# To boot the web + API locally you only need the values below. Everything after
# the "OPTIONAL / READINESS-GATED" divider can stay empty for local development.
#
#   DATABASE_URL         Postgres connection string (docker-compose.yml uses port 5434)
#   AUTH_SECRET          >= 32 chars. Generate with: openssl rand -base64 32
#   NEXT_PUBLIC_API_URL  API origin the browser calls (local default http://localhost:4000)
#   FRONTEND_URL         Web origin (local default http://localhost:3000)
#
# Quick start:
#   cp .env.example .env
#   npm run db:up          # starts Postgres 16 (port 5434)
#   npm run db:migrate     # applies Drizzle migrations
#   npm run dev:api        # http://localhost:4000
#   npm run dev:web        # http://localhost:3000
#
# NOTE: production deploys (Cloudflare Workers) do NOT read this file - secrets
# are set with `wrangler secret put` / dashboard variables. See
# docs/deployment/ for details.
# =============================================================================

DATABASE_URL=postgres://sales_saas:sales_saas@localhost:5434/sales_aaas
API_PORT=4000
# Production web readiness requires a real HTTPS API origin here.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional release/content freshness date used by the public sitemap lastmod field.
SITE_CONTENT_UPDATED_AT=2026-06-06T00:00:00.000Z
# Production API readiness requires a real HTTPS app origin here.
FRONTEND_URL=http://localhost:3000

# Production rate limiting and proxy trust
# Production API /ready blocks until an edge/WAF or durable backend owns horizontal rate limits.
# Set exactly one of these after the external control is deployed.
DURABLE_RATE_LIMITS_ENABLED=false
RATE_LIMIT_BACKEND=
# Trust forwarded client IP headers only when your proxy/edge strips spoofed values.
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# Auth (NextAuth)
# Production readiness requires a non-placeholder value with at least 32 characters.
AUTH_SECRET=your-secret-key-min-32-chars-change-in-production
# For Google OAuth, also set in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# OPTIONAL / READINESS-GATED (leave empty for local development)
# =============================================================================
# Everything below configures billing, communications, source providers, and
# governance readiness gates. Missing values keep the matching feature in a safe
# "not configured" state; the app still boots.

# Stripe (Global payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs from your dashboard (set in .env or keep in code)
# Example: STRIPE_PRICE_STARTER=price_xxx, STRIPE_PRICE_PRO=price_xxx, STRIPE_PRICE_ELITE=price_xxx

# Razorpay (India payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay plan IDs from your dashboard
# Example: RAZORPAY_PLAN_STARTER=plan_xxx, RAZORPAY_PLAN_PRO=plan_xxx, RAZORPAY_PLAN_ELITE=plan_xxx

# Communications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TWIML_URL=
TWILIO_STATUS_CALLBACK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_COMMAND_RATE_LIMIT_MAX=12
TELEGRAM_COMMAND_RATE_LIMIT_WINDOW_SECONDS=60
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_NOTIFICATION_TARGET_CHAT_ID=
TELEGRAM_NOTIFICATION_SCHEDULER_SECRET=
TELEGRAM_NOTIFICATION_POLICY_CONFIGURED=false
TELEGRAM_NOTIFICATION_POLICY_URL=
TELEGRAM_NOTIFICATION_QUIET_HOURS_CONFIGURED=false
TELEGRAM_NOTIFICATION_QUIET_HOURS_POLICY_URL=
TELEGRAM_NOTIFICATION_QUIET_HOURS_START=22:00
TELEGRAM_NOTIFICATION_QUIET_HOURS_END=08:00
TELEGRAM_NOTIFICATION_TIME_ZONE=UTC
TELEGRAM_NOTIFICATION_ESCALATION_OWNER=
TELEGRAM_NOTIFICATION_DIGEST_CONFIGURED=false
TELEGRAM_NOTIFICATION_DIGEST_SCHEDULE_URL=
TELEGRAM_NOTIFICATION_APPROVAL_ALERTS_CONFIGURED=false
TELEGRAM_NOTIFICATION_PROVIDER_ALERTS_CONFIGURED=false
TELEGRAM_NOTIFICATION_CONVERSION_ALERTS_CONFIGURED=false
TELEGRAM_NOTIFICATION_INCIDENT_ALERTS_CONFIGURED=false
TELEGRAM_NOTIFICATION_DELIVERY_AUDIT_CONFIGURED=false
