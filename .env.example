CRM_SYNC_CONFIGURED=false
CRM_SYNC_PROVIDER_URL=
CRM_FIELD_MAPPING_CONFIGURED=false
CRM_FIELD_MAPPING_POLICY_URL=
CALENDAR_SYNC_CONFIGURED=false
CALENDAR_SYNC_PROVIDER_URL=
