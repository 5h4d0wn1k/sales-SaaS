+def check_gitattributes(root: Path, findings: list[Finding]) -> None:
+    relpath = GIT_ATTRIBUTES_PATH
+    path = root / relpath
+    if not path.exists():
+        findings.append(
+            Finding(
+                "warn",
+                "gitattributes.missing",
+                relpath,
+                "Git attributes should document archived patch evidence whitespace handling.",
+            )
+        )
+        return
+
+    for line in read_text(path).splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        tokens = stripped.split()
+        if (
+            tokens
+            and tokens[0] == ARCHIVED_PATCH_ATTRIBUTE_PATTERN
+            and ARCHIVED_PATCH_ATTRIBUTE_TOKEN in tokens[1:]
+        ):
+            findings.append(
+                Finding(
+                    "pass",
+                    "gitattributes.archived_patch_whitespace",
+                    relpath,
+                    "Archived dirty-worktree patch evidence disables whitespace scanning.",
+                    f"{ARCHIVED_PATCH_ATTRIBUTE_PATTERN} {ARCHIVED_PATCH_ATTRIBUTE_TOKEN}",
+                )
+            )
+            return
+
+    findings.append(
+        Finding(
+            "warn",
+            "gitattributes.archived_patch_whitespace",
+            relpath,
+            "Archived dirty-worktree patch evidence should disable whitespace scanning.",
+            f"expected `{ARCHIVED_PATCH_ATTRIBUTE_PATTERN} {ARCHIVED_PATCH_ATTRIBUTE_TOKEN}`",
+        )
+    )
+
