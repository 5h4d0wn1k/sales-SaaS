{
  "name": "sales-aaas-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.10.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "dev:web": "npm run dev --workspace @sales/web",
    "dev:api": "npm run dev --workspace @sales/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:generate": "npm run db:generate --workspace @sales/database",
    "db:migrate": "npm run db:migrate --workspace @sales/database"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "@esbuild-kit/esm-loader": {
      "esbuild": "^0.25.0"
    }
  }
}