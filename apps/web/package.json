{
  "name": "@sales/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:artifacts": "node ./scripts/rotate-build-artifacts.mjs",
    "dev": "next dev",
    "build": "node ./scripts/run-next-build.mjs",
    "build:cf-worker": "opennextjs-cloudflare build",
    "preview": "npm run build:cf-worker && opennextjs-cloudflare preview --skipBuild",
    "deploy": "npm run build:cf-worker && wrangler deploy --config wrangler.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "typecheck": "next typegen && tsc --project tsconfig.json --noEmit --incremental false",
    "test": "vitest run"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.5",
    "wrangler": "^4.87.0"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@sales/shared": "file:../../packages/shared",
    "@tailwindcss/postcss": "^4.2.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "next": "^15.2.2",
    "next-auth": "^5.0.0-beta.30",
    "postcss": "^8.5.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  }
}
