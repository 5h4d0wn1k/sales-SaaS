{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 .codex/hooks/session_start_context.py"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^Bash$",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 .codex/hooks/pre_tool_use_policy.py"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^Bash$",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 .codex/hooks/post_tool_use_review.py"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 .codex/hooks/stop_require_verification.py"
        }
      ]
    }
  ]
}
